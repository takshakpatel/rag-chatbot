# Backend environment variables — Lumen (local-first defaults)
# The whole pipeline runs locally; no paid API keys are required by default.

# --- Models (all local) ---
# LLM served by Ollama (https://ollama.com) on localhost:11434 (default).
LLM_MODEL=llama3.2

# Local embedding model (sentence-transformers/all-MiniLM-L6-v2).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local cross-encoder used for re-ranking (sentence-transformers model).
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Storage ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Optional: only needed if you switch to OpenAI-based models ---
# OPENAI_API_KEY=
