# Backend environment variables — Lumen
# Switch from local Ollama to Groq cloud LLM (fast, free tier).

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here

# --- Models ---
# LLM via Groq API (https://console.groq.com)
LLM_MODEL=llama-3.3-70b-versatile

# Local embedding model (sentence-transformers/all-MiniLM-L6-v2).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local cross-encoder used for re-ranking (sentence-transformers model).
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Storage ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Ingestion ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
